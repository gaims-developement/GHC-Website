PORT=5000
CLIENT_URLS=https://globalhealthconclave.netlify.app,https://www.globalhealthconclave.netlify.app,http://localhost:5173,http://localhost:3000

# Required Aiven MySQL connection settings.
# The server enables SSL automatically because Aiven requires it.
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=your-aiven-port
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_CONNECT_TIMEOUT_MS=15000
DB_CONNECTION_LIMIT=10

JWT_SECRET=
JWT_EXPIRES_IN=7d

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
