PORT=3000
APP_URL=https://your-railway-backend.up.railway.app
CLIENT_URLS=https://globalhealthconclave.netlify.app,https://www.globalhealthconclave.netlify.app,http://localhost:5173,http://localhost:3000

# Required Aiven MySQL connection settings.
# The server enables SSL automatically because Aiven requires it.
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=your-aiven-port
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_CONNECT_TIMEOUT_MS=15000
DB_CONNECTION_LIMIT=10
HEALTHCHECK_DB_TIMEOUT_MS=2000

CRON_ENABLED=true
CRON_INTERVAL_MINUTES=5
CRON_TIMEOUT_MS=10000

JWT_SECRET=
JWT_EXPIRES_IN=7d

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
TRAILER_MAX_UPLOAD_SIZE=209715200

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

STRIPE_SECRET_KEY=
